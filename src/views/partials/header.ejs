<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | CSE 340 Service Network</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <a href="/" class="site-title">CSE 340 Service Network</a>

            <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-label="Toggle navigation">
                <span id="navToggleIcon">&#9776;</span>
            </button>

            <nav id="mainNav">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/organizations">Organizations</a></li>
                    <li><a href="/projects">Projects</a></li>
                    <li><a href="/categories">Categories</a></li>
                    <% if (isAdmin) { %>
                        <li><a href="/new-organization">New Organization</a></li>
                        <li><a href="/new-project">New Project</a></li>
                        <li><a href="/new-category">New Category</a></li>
                    <% } %>
                    <% if (isLoggedIn) { %>
                        <li><a href="/dashboard">Dashboard</a></li>
                        <li><a href="/logout">Logout</a></li>
                    <% } else { %>
                        <li><a href="/register">Register</a></li>
                        <li><a href="/login">Login</a></li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </header>

    <script>
        const navToggle = document.getElementById('navToggle');
        const mainNav   = document.getElementById('mainNav');
        const toggleIcon = document.getElementById('navToggleIcon');

        navToggle.addEventListener('click', () => {
            const isOpen = mainNav.classList.toggle('open');
            navToggle.setAttribute('aria-expanded', isOpen);
            toggleIcon.innerHTML = isOpen ? '&#10005;' : '&#9776;';
        });

        mainNav.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mainNav.classList.remove('open');
                navToggle.setAttribute('aria-expanded', 'false');
                toggleIcon.innerHTML = '&#9776;';
            });
        });
    </script>

    <div class="flash-messages">
        <% const messages = flash(); %>
        <% Object.keys(messages).forEach(type => { %>
            <% if (messages[type].length > 0) { %>
                <% messages[type].forEach(msg => { %>
                    <div class="alert <%= type %>"><%= msg %></div>
                <% }); %>
            <% } %>
        <% }); %>
    </div>
