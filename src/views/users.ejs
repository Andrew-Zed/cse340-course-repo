<%- include('partials/header') %>
<main>
    <div class="page-header">
        <h1><%= title %></h1>
    </div>

    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(u => { %>
                    <tr>
                        <td><%= u.name %></td>
                        <td><%= u.email %></td>
                        <td><%= u.role_name %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <p><a href="/dashboard">&larr; Back to Dashboard</a></p>
</main>
<%- include('partials/footer') %>
