<%- include('partials/header') %>
<main>
    <div class="page-header">
        <h1><%= title %></h1>
    </div>

    <section>
        <div class="section-header">
            <h2>Account Information</h2>
        </div>
        <dl class="dashboard-info">
            <dt>Name</dt>
            <dd><%= name %></dd>
            <dt>Email</dt>
            <dd><%= email %></dd>
        </dl>

        <% if (user && user.role_name === 'admin') { %>
            <div class="admin-actions">
                <a href="/users">Manage Users</a>
            </div>
        <% } %>
    </section>

    <section>
        <div class="section-header">
            <h2>My Volunteer Projects</h2>
        </div>

        <% if (volunteerProjects && volunteerProjects.length > 0) { %>
            <ul class="card-list">
                <% volunteerProjects.forEach(project => { %>
                    <li class="card">
                        <p class="card-meta">
                            <%= new Date(project.project_date).toLocaleDateString('en-US', {
                                year: 'numeric', month: 'long', day: 'numeric'
                            }) %>
                            &mdash; <%= project.organization_name %>
                        </p>
                        <p class="card-title">
                            <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                        </p>
                        <form action="/remove-volunteer/<%= project.project_id %>" method="POST" style="margin-top: 10px;">
                            <button type="submit">Remove myself as a volunteer</button>
                        </form>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p class="empty-state">You have not signed up to volunteer for any projects yet.
                <a href="/projects">Browse projects</a>.
            </p>
        <% } %>
    </section>
</main>
<%- include('partials/footer') %>
