<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">Manage Users</a></p>
    <% } %>

    <h3>My Volunteer Projects</h3>
    <% if (volunteerProjects && volunteerProjects.length > 0) { %>
        <ul>
            <% volunteerProjects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    &mdash; <%= project.organization_name %> &mdash;
                    <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                    <form action="/remove-volunteer/<%= project.project_id %>" method="POST" style="display: inline;">
                        <button type="submit">Remove</button>
                    </form>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>You have not signed up to volunteer for any projects yet.</p>
    <% } %>

</main>

<%- include('partials/footer') %>