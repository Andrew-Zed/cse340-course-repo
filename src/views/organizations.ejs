<%- include('partials/header') %>
<main>
    <div class="page-header">
        <h1><%= title %></h1>
        <p>Partner organizations coordinating volunteer projects</p>
    </div>

    <ul class="card-list">
        <% organizations.forEach(org => { %>
            <li class="card">
                <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo"
                     style="max-height: 56px; max-width: 120px; display: block; margin-bottom: 10px;">
                <p class="card-title">
                    <a href="/organization/<%= org.organization_id %>"><%= org.name %></a>
                </p>
                <p class="card-meta"><%= org.contact_email %></p>
            </li>
        <% }) %>
    </ul>

    <% if (user && user.role_name === 'admin') { %>
        <div class="admin-actions">
            <a href="/new-organization">+ Add New Organization</a>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>
