<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <!-- <h2><%= categoryDetails.name %></h2> -->

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-category/<%= categoryDetails.category_id %>">Edit Category</a></p>
    <% } %>

    <h3>Service Projects in this Category</h3>
    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <strong>
                        <%= new Date(project.project_date).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        }) %>:
                    </strong>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                    <p><%= project.description %></p>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects are currently available for this category.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
