<%- include('partials/header') %>
<main>
    <div class="page-header">
        <h1><%= title %></h1>
    </div>

    <article class="detail-view">
        <img class="org-logo" src="/images/<%= organizationDetails.logo_filename %>"
             alt="<%= organizationDetails.name %> logo">

        <dl class="detail-meta">
            <dt>Contact</dt>
            <dd><a href="mailto:<%= organizationDetails.contact_email %>"><%= organizationDetails.contact_email %></a></dd>
        </dl>

        <div class="detail-section">
            <h2>About</h2>
            <p><%= organizationDetails.description %></p>
        </div>

        <div class="detail-section">
            <h2>Active Service Projects</h2>
            <% if (projects && projects.length > 0) { %>
                <ul class="card-list">
                    <% projects.forEach(project => { %>
                        <li class="card">
                            <p class="card-meta">
                                <%= new Date(project.project_date).toLocaleDateString('en-US', {
                                    year: 'numeric', month: 'long', day: 'numeric'
                                }) %>
                            </p>
                            <p class="card-title">
                                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                            </p>
                            <p class="card-description"><%= project.description %></p>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p class="empty-state">No service projects currently available for this organization.</p>
            <% } %>
        </div>

        <% if (user && user.role_name === 'admin') { %>
            <div class="admin-actions">
                <a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a>
            </div>
        <% } %>
    </article>
</main>
<%- include('partials/footer') %>
