<%- include('partials/header') %>
<main>
    <div class="page-header">
        <h1><%= title %></h1>
    </div>

    <article class="detail-view">
        <dl class="detail-meta">
            <dt>Organization</dt>
            <dd><a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></dd>

            <dt>Date</dt>
            <dd><%= new Date(projectDetails.project_date).toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric'
            }) %></dd>

            <dt>Location</dt>
            <dd><%= projectDetails.location %></dd>
        </dl>

        <div class="detail-section">
            <h2>About this Project</h2>
            <p><%= projectDetails.description %></p>
        </div>

        <% if (isLoggedIn) { %>
            <div class="volunteer-section">
                <% if (volunteering) { %>
                    <p>You are volunteering for this project.</p>
                    <form action="/remove-volunteer/<%= projectDetails.project_id %>" method="POST">
                        <button type="submit">Remove myself as a volunteer</button>
                    </form>
                <% } else { %>
                    <form action="/volunteer/<%= projectDetails.project_id %>" method="POST">
                        <button type="submit">Volunteer for this project</button>
                    </form>
                <% } %>
            </div>
        <% } %>

        <div class="detail-section">
            <h3>Categories</h3>
            <% if (categories && categories.length > 0) { %>
                <ul>
                    <% categories.forEach(category => { %>
                        <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p class="empty-state">No categories assigned to this project.</p>
            <% } %>
        </div>

        <% if (user && user.role_name === 'admin') { %>
            <div class="admin-actions">
                <a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a>
                <a href="/assign-categories/<%= projectDetails.project_id %>">Assign Categories</a>
            </div>
        <% } %>
    </article>
</main>
<%- include('partials/footer') %>
