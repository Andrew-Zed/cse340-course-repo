<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <!-- <h2><%= projectDetails.title %></h2> -->
    <p><strong>Organization:</strong>
        <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a>
    </p>
    <p><strong>Date:</strong>
        <%= new Date(projectDetails.project_date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        }) %>
    </p>
    <p><strong>Location:</strong> <%= projectDetails.location %></p>
    <p><strong>Description:</strong> <%= projectDetails.description %></p>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
        <p><a href="/assign-categories/<%= projectDetails.project_id %>">Assign Categories</a></p>
    <% } %>

    <h3>Categories</h3>
    <% if (categories && categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No categories are assigned to this project.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
