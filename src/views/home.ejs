<%- include('partials/header') %>
<main>
    <div class="page-header">
        <h1><%= title %></h1>
    </div>

    <p class="home-intro">
        Our mission is to promote service across the world by connecting volunteers
        with service opportunities in their community.
    </p>

    <img class="main-logo" src="images/cse340-service-network.png" alt="CSE 340 Service Network Logo">

    <% if (isLoggedIn) { %>
        <p><a href="/dashboard">Go to My Dashboard</a></p>
    <% } else { %>
        <p><a href="/register">Register</a> or <a href="/login">Login</a> to start volunteering.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
