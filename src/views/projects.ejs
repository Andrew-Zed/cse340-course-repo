<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <!-- <h2>Upcoming Service Projects</h2> -->

        <% if(projects && projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <strong>
                            <%= new Date(project.project_date).toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric'
                            }) %>:
                        </strong>

                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>

                        (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                    </li>
                <% }) %>
            </ul>
            <% } else { %>
                <p>No Service projects are available at this time.</p>
            <% } %>
        <% if (user && user.role_name === 'admin') { %>
            <p><a href="/new-project">Add a New Service Project</a></p>
        <% } %>
    </main>
<%- include('partials/footer') %>