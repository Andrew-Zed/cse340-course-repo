<%- include('partials/header') %>
<main>
    <div class="page-header">
        <h1><%= title %></h1>
        <p>Upcoming opportunities to serve in your community</p>
    </div>

    <% if (projects && projects.length > 0) { %>
        <ul class="card-list">
            <% projects.forEach(project => { %>
                <li class="card">
                    <p class="card-meta">
                        <%= new Date(project.project_date).toLocaleDateString('en-US', {
                            year: 'numeric', month: 'long', day: 'numeric'
                        }) %>
                        &mdash;
                        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    </p>
                    <p class="card-title">
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    </p>
                    <p class="card-description"><%= project.description %></p>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p class="empty-state">No service projects are available at this time.</p>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <div class="admin-actions">
            <a href="/new-project">+ Add a New Service Project</a>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>
